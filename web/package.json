{
  "name": "recoow-web",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm generate && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "check": "pnpm generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "format": "prettier --config .prettierrc.json --write . ../openapi/openapi.yaml",
    "format:check": "prettier --config .prettierrc.json --check . ../openapi/openapi.yaml",
    "lint": "eslint .",
    "verify": "pnpm format:check && pnpm lint && pnpm check && pnpm test && pnpm build && pnpm test:browser",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@lucide/svelte": "^1.68.0",
    "@tanstack/svelte-query": "^6.3.10",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "lossless-json": "^4.3.3",
    "mode-watcher": "^1.1.0",
    "svelte-i18n": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.20.0",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
