  "components": [
    {
      "name": "主按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "查询等主要操作。",
      "html": "<button class=\"ds-primary\">查询</button>",
      "css": ".ds-primary{height:36px;padding:0 14px;border:1px solid transparent;border-radius:6px;background:var(--primary);color:light-dark(#fff,#102542);font:500 14px system-ui;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),color 160ms cubic-bezier(0.16,1,0.3,1);}.ds-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent);}.ds-primary:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}.ds-primary:active{transform:translateY(1px);}.ds-primary:disabled{opacity:.5;cursor:not-allowed;}"
    },
    {
      "name": "次按钮",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "重置和次要操作。",
      "html": "<button class=\"ds-outline\">重置</button>",
      "css": ".ds-outline{height:36px;padding:0 14px;border:1px solid var(--border);border-radius:6px;background:light-dark(var(--background),color-mix(in oklab,var(--border) 30%,transparent));color:var(--foreground);font:500 14px system-ui;cursor:pointer;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),color 160ms cubic-bezier(0.16,1,0.3,1);}.ds-outline:hover{background:light-dark(var(--muted),color-mix(in oklab,var(--border) 50%,transparent));}.ds-outline:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}.ds-outline:active{transform:translateY(1px);}"
    },
    {
      "name": "文本输入",
      "kind": "input",
      "refersTo": "input",
      "description": "统一标签、描边与焦点。",
      "html": "<label class=\"ds-field\">搜索<input class=\"ds-input\" placeholder=\"搜索记录内容\" /></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:500 13px system-ui;color:var(--foreground);}.ds-input{height:36px;padding:0 12px;border:1px solid var(--input-border);border-radius:6px;background:var(--card);color:var(--foreground);font:400 14px system-ui;caret-color:var(--primary);}.ds-input::placeholder{color:var(--muted-foreground);}.ds-input:hover{border-color:var(--primary);}.ds-input:focus{border-color:var(--primary);outline:2px solid var(--primary-soft);outline-offset:0;}.ds-input:disabled{background:var(--muted);color:var(--muted-foreground);}"
    },
    {
      "name": "选择触发器",
      "kind": "custom",
      "description": "下拉与日期共享的控件形态；实际交互由 Bits UI 提供。",
      "html": "<button class=\"ds-select\" aria-haspopup=\"listbox\"><span>全部</span><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-select{width:100%;height:36px;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:0 12px;border:1px solid var(--input-border);border-radius:6px;background:var(--card);color:var(--foreground);font:400 14px system-ui;cursor:pointer;}.ds-select svg{color:var(--muted-foreground);}.ds-select:hover,.ds-select[aria-expanded=true]{border-color:var(--primary);}.ds-select:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}"
    },
    {
      "name": "当前导航",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "当前工作区或类型入口。",
      "html": "<a class=\"ds-nav\" href=\"#records\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><path d=\"M9 4v16\"/></svg><span>记录</span></a>",
      "css": ".ds-nav{display:flex;align-items:center;gap:12px;height:42px;padding:0 16px;border-radius:6px;background:var(--primary-soft);color:var(--primary);font:500 14px system-ui;text-decoration:none;transition:background-color 160ms cubic-bezier(0.16,1,0.3,1),color 160ms cubic-bezier(0.16,1,0.3,1);}.ds-nav:hover{background:var(--primary-soft);color:var(--primary);}.ds-nav:focus-visible{outline:2px solid var(--primary);outline-offset:3px;}"
    },
    {
      "name": "变化标记",
      "kind": "chip",
